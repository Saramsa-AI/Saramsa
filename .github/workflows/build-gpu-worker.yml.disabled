name: Build and Push GPU Worker Image

on:
  push:
    branches:
      - feature/hybrid-gpu-spot-optimization
      - master
    paths:
      - 'backend/**'
      - 'backend/Dockerfile.gpu'
      - '.github/workflows/build-gpu-worker.yml'
  workflow_dispatch:

env:
  ACR_NAME: saramsa
  IMAGE_NAME: saramsa-celery-gpu
  RESOURCE_GROUP: saramsa

jobs:
  build-and-push:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Azure Login
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Get ACR credentials
        id: acr-creds
        run: |
          ACR_USERNAME=$(az acr credential show --name ${{ env.ACR_NAME }} --query username -o tsv)
          ACR_PASSWORD=$(az acr credential show --name ${{ env.ACR_NAME }} --query "passwords[0].value" -o tsv)
          echo "::add-mask::$ACR_PASSWORD"
          echo "username=$ACR_USERNAME" >> $GITHUB_OUTPUT
          echo "password=$ACR_PASSWORD" >> $GITHUB_OUTPUT

      - name: Log in to Azure Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.ACR_NAME }}.azurecr.io
          username: ${{ steps.acr-creds.outputs.username }}
          password: ${{ steps.acr-creds.outputs.password }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.ACR_NAME }}.azurecr.io/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=sha,prefix={{branch}}-
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push GPU worker image
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          file: ./backend/Dockerfile.gpu
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=registry,ref=${{ env.ACR_NAME }}.azurecr.io/${{ env.IMAGE_NAME }}:buildcache
          cache-to: type=registry,ref=${{ env.ACR_NAME }}.azurecr.io/${{ env.IMAGE_NAME }}:buildcache,mode=max
          platforms: linux/amd64

      - name: Image details
        run: |
          echo "✅ GPU worker image built and pushed:"
          echo "${{ steps.meta.outputs.tags }}"
          echo ""
          echo "📦 Image size: $(docker image inspect ${{ env.ACR_NAME }}.azurecr.io/${{ env.IMAGE_NAME }}:latest --format='{{.Size}}' | numfmt --to=iec-i --suffix=B || echo 'N/A')"
          echo ""
          echo "🚀 To deploy GPU worker:"
          echo "  cd infrastructure && ./deploy-spot-gpu.sh"

      - name: Notify on failure
        if: failure()
        run: |
          echo "::error::GPU worker image build failed. Check logs for details."
