# Saramsa Django API image.
# Uses the pre-built base image (Dockerfile.api-base) for fast builds.
# Rebuilt when application code changes (~2-3 min).

ARG BASE_IMAGE=saramsa/saramsa-api-base:latest

FROM ${BASE_IMAGE}

WORKDIR /app

COPY backend/ ./

# Collect static files at image build time so the runtime container is read-only.
RUN python manage.py collectstatic --noinput || \
    echo "collectstatic skipped (likely missing env at build time — Azure will retry on boot)"

EXPOSE 8000

# Run Django migrations on container startup, then exec gunicorn.
#
# Why this is here:
#   Before this change, the deploy workflow built + pushed a Docker image
#   and Azure App Service restarted the container. Django migrations were
#   NEVER part of the deploy — they had to be applied manually, which was
#   easy to forget. The auth-flow audit's 0008_hash_invite_tokens migration
#   shipped with PR #44 but didn't apply for that reason, breaking invite
#   acceptance in prod until someone manually ran `manage.py migrate`.
#
#   Running migrations at container start makes the deploy self-contained:
#   the image that ships the new code also applies the schema changes it
#   needs. The container can't accept traffic until migrate finishes
#   (gunicorn doesn't bind to :8000 until then).
#
# Important properties:
#   - `--noinput` skips the "are you sure?" prompt (no TTY in containers)
#   - migrate is idempotent — re-running on a healthy DB is a fast no-op
#   - if migrate fails, gunicorn never starts → Azure healthcheck fails →
#     deploy is marked failed and the OLD container keeps serving. Safer
#     than the old behavior where a broken migration silently shipped.
#   - we use `exec` so gunicorn becomes PID 1, receiving signals properly
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn --bind=0.0.0.0:8000 --timeout 600 --workers 2 --access-logfile - --error-logfile - --log-level info apis.wsgi:application"]
